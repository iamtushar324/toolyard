def bundle_url(base, url):
    """The bundle's download URL: a path is on TOOLYARD_URL; an absolute URL
    must be https, or http on TOOLYARD_URL's own origin."""
    if url.startswith("/") and not url.startswith("//"):
        return base + url
    try:
        parts = urllib.parse.urlsplit(url)
        own = urllib.parse.urlsplit(base)
    except ValueError:
        raise TyError("the server answered with a download URL that does not parse")
    if not parts.hostname or parts.username or parts.password:
        raise TyError("the server answered with an unusable download URL")
    if parts.scheme == "https" or (parts.scheme == "http" and (parts.scheme, parts.netloc) == (own.scheme, own.netloc)):
        return url
    raise TyError("the server answered with a download URL that is not https")


def download_bundle(url):
    """GETs the bundle. The single-use ticket in the URL is the credential:
    the token is never sent, redirects are refused and the URL is never
    printed."""
    req = urllib.request.Request(url, method="GET")
    req.add_header("User-Agent", "ty/1 (toolyard skills pull)")
    try:
        with _OPENER.open(req, timeout=120) as resp:
            data = resp.read(MAX_BUNDLE_BYTES + 1)
    except urllib.error.HTTPError as e:
        try:
            body = parse_json(e.read())
        except Exception:
            body = None
        detail = body.get("error") if isinstance(body, dict) and isinstance(body.get("error"), str) else ""
        raise TyError("downloading the bundle failed: HTTP %d %s" % (e.code, " ".join(detail.split())[:300]))
    except urllib.error.URLError as e:
        raise TyError("cannot download the bundle: %s" % e.reason)
    except (OSError, http.client.HTTPException) as e:
        raise TyError("downloading the bundle failed: %s" % e)
    if len(data) > MAX_BUNDLE_BYTES:
        raise TyError("the bundle is over %d MiB; pull fewer skills at once" % (MAX_BUNDLE_BYTES >> 20))
    return data


def bundle_member_parts(name, folders):
    """The path segments of one archive member, or a TyError when the member
    could land outside its skill folder."""
    if not name or "\x00" in name or "\\" in name:
        raise TyError("refusing the bundle: member %r has an unsafe name" % name[:200])
    if name.startswith("/") or re.match(r"^[A-Za-z]:", name):
        raise TyError("refusing the bundle: member %r has an absolute path" % name[:200])
    parts = name.split("/")
    if parts and parts[-1] == "":
        parts = parts[:-1]  # a folder entry ends with "/"
    if not parts or any(p in ("", ".", "..") for p in parts):
        raise TyError("refusing the bundle: member %r is not a plain path inside a skill folder" % name[:200])
    if parts[0] not in folders:
        raise TyError("refusing the bundle: member %r is outside the skills the server named" % name[:200])
    return parts


def extract_bundle(data, staging, folders):
    """Unpacks the bundle into staging, one folder per skill. Only regular
    files and folders; every file is written new (mode 0644), never through
    an existing path. Returns {folder: file count}."""
    counts = {}
    total = 0
    members = 0
    try:
        archive = tarfile.open(fileobj=io.BytesIO(data), mode="r:gz")
    except (tarfile.TarError, OSError, EOFError) as e:
        raise TyError("the bundle is not a valid .tar.gz: %s" % e)
    with archive:
        try:
            for m in archive:
                members += 1
                if members > MAX_BUNDLE_MEMBERS:
                    raise TyError("refusing the bundle: more than %d members" % MAX_BUNDLE_MEMBERS)
                parts = bundle_member_parts(m.name, folders)
                if m.issym() or m.islnk():
                    raise TyError("refusing the bundle: member %r is a link" % m.name[:200])
                dest = os.path.join(staging, *parts)
                if m.isdir():
                    os.makedirs(dest, mode=0o755, exist_ok=True)
                    continue
                if not m.isreg():
                    raise TyError("refusing the bundle: member %r is not a regular file" % m.name[:200])
                total += m.size
                if total > MAX_UNPACKED_BYTES:
                    raise TyError("refusing the bundle: over %d MiB unpacked" % (MAX_UNPACKED_BYTES >> 20))
                os.makedirs(os.path.dirname(dest), mode=0o755, exist_ok=True)
                src = archive.extractfile(m)
                if src is None:
                    raise TyError("refusing the bundle: member %r has no content" % m.name[:200])
                flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_BINARY", 0)
                try:
                    fd = os.open(dest, flags, 0o644)
                except FileExistsError:
                    raise TyError("refusing the bundle: member %r appears twice" % m.name[:200])
                with os.fdopen(fd, "wb") as out:
                    left = m.size
                    while left > 0:
                        chunk = src.read(min(left, 1 << 20))
                        if not chunk:
                            raise TyError("the bundle is truncated at %r" % m.name[:200])
                        out.write(chunk)
                        left -= len(chunk)
                counts[parts[0]] = counts.get(parts[0], 0) + 1
        except (tarfile.TarError, EOFError, OSError) as e:
            raise TyError("unpacking the bundle failed: %s" % e)
    return counts


def cmd_skills_pull(client, args):
    target = os.path.abspath(os.path.expanduser(args.dir or DEFAULT_SKILLS_DIR))
    body = {"skills": args.skills}
    if args.reason:
        body["reason"] = check_reason(args.reason)
    status, headers, data = client.send("POST", "/v1/skills/bundle", json.dumps(body, ensure_ascii=False).encode("utf-8"),
                                        {"Content-Type": "application/json"})
    answer = parse_json(data)
    if status != 200 or not isinstance(answer, dict) or not isinstance(answer.get("url"), str):
        return error_exit(status, headers, data)
    skills = [s for s in answer.get("skills") or [] if isinstance(s, dict)]
    folders = []
    for s in skills:
        name = s.get("name")
        if not isinstance(name, str) or not SKILL_FOLDER.match(name) or name in (".", ".."):
            raise TyError("the server named a skill folder ty will not write: %r" % (str(name)[:200],))
        folders.append(name)
    if not folders:
        raise TyError("the server named no skills to pull")
    if os.path.lexists(target) and not os.path.isdir(target):
        raise TyError("--dir %s exists and is not a folder" % target)
    try:
        os.makedirs(target, mode=0o755, exist_ok=True)
    except OSError as e:
        raise TyError("cannot make --dir %s: %s" % (target, e.strerror or e))
    present = [f for f in folders if os.path.lexists(os.path.join(target, f))]
    if present and not args.force:
        raise TyError("%s already in %s: pass --force to replace %s" % (", ".join(present), target,
                                                                         "it" if len(present) == 1 else "them"))
    bundle = download_bundle(bundle_url(client.base, answer["url"]))
    out = []
    try:
        staging = tempfile.mkdtemp(prefix=".ty-pull-", dir=target)
    except OSError as e:
        raise TyError("cannot write in --dir %s: %s" % (target, e.strerror or e))
    try:
        counts = extract_bundle(bundle, os.path.join(staging, "new"), set(folders))
        old = os.path.join(staging, "old")
        os.makedirs(old)
        for s, name in zip(skills, folders):
            src = os.path.join(staging, "new", name)
            if name not in counts or not os.path.isdir(src):
                continue
            dst = os.path.join(target, name)
            replaced = os.path.lexists(dst)
            if replaced:
                # Move the old folder (or file, or link itself) aside first,
                # and put it back if the new one cannot take its place.
                os.rename(dst, os.path.join(old, name))
                try:
                    os.rename(src, dst)
                except OSError:
                    os.rename(os.path.join(old, name), dst)
                    raise
            else:
                os.rename(src, dst)
            out.append({"name": name, "path": dst, "files": counts[name], "replaced": replaced,
                        "uri": s.get("uri"), "source": s.get("source"), "repo": s.get("repo"), "commit": s.get("commit")})
    except OSError as e:
        raise TyError("installing the skills failed: %s" % e)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    emit_json({"dir": target, "skills": out})
    return EXIT_SUCCEEDED


def seconds(text):
    try:
        n = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError("must be a whole number of seconds")
    if n < 0:
        raise argparse.ArgumentTypeError("must be 0 or more")
    return n


def build_parser():
    p = argparse.ArgumentParser(prog="ty", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", metavar="COMMAND")
    wait_help = "wait up to N seconds for the run to finish or be held (polls past 60)"

    r = sub.add_parser("run", help="run a script file, or - for stdin")
    r.add_argument("file", metavar="FILE|-")
    r.add_argument("--wait", type=seconds, metavar="N", help=wait_help)
    r.add_argument("--key", metavar="IDEMPOTENCY_KEY",
                   help="reuse this key on a retry to get the same run back (default: a new random key)")
    r.add_argument("--reason", metavar="TEXT", help="why you run it, 20-2000 characters, for the audit")
    r.add_argument("--language", choices=("starlark", "javascript"),
                   help="the script's language (default: javascript for .js and .mjs files, else starlark)")
    r.set_defaults(func=cmd_run)

    s = sub.add_parser("status", help="show a run")
    s.add_argument("run_id", metavar="RUN_ID")
    s.add_argument("--wait", type=seconds, metavar="N", help=wait_help)
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("resume", help="resume a held run after the owner decided")
    s.add_argument("run_id", metavar="RUN_ID")
    s.add_argument("--request", metavar="rq_...",
                   help="the approved Inbox request that covers the held call (omit for a legacy deferred approval)")
    s.add_argument("--wait", type=seconds, metavar="N", help=wait_help)
    s.set_defaults(func=cmd_resume)

    s = sub.add_parser("files", help="list the tool stubs you may use (like listToolFiles)")
    s.add_argument("--language", choices=("starlark", "javascript"), default="starlark",
                   help="javascript lists the TypeScript stubs (.d.ts)")
    s.set_defaults(func=cmd_files)

    s = sub.add_parser("stub", help="print one tool stub (like readToolFile)")
    s.add_argument("target", metavar="SERVER/TOOL")
    s.add_argument("--language", choices=("starlark", "javascript"), default="starlark",
                   help="javascript prints the TypeScript stub (.d.ts); a target ending in .d.ts does too")
    s.set_defaults(func=cmd_stub)

    s = sub.add_parser("search", help="search the tools you may use (like tools.search)")
    s.add_argument("query", metavar="QUERY")
    s.add_argument("--mode", choices=("keyword", "regex", "semantic", "auto"),
                   help="keyword (default): ranked words; regex: an RE2 pattern of at most 200 characters")
    s.add_argument("--detail", choices=("name", "summary", "full"), help="full adds the input and output schemas")
    s.add_argument("--limit", type=int, metavar="N", help="at most N results (default 50, at most 200)")
    s.add_argument("--upstream", metavar="SERVER", help="only the tools of this upstream server")
    s.set_defaults(func=cmd_search)

    s = sub.add_parser("call", help="call one tool as a one-line script")
    s.add_argument("target", metavar="SERVER.TOOL")
    s.add_argument("args", metavar="ARGS_JSON", nargs="?", default="{}",
                   help="the arguments as a JSON object, or - to read it from stdin (default: {})")
    s.add_argument("--reason", metavar="TEXT", help="why you call it, 20-2000 characters, for the audit")
    s.add_argument("--wait", type=seconds, metavar="N", help=wait_help)
    s.add_argument("--key", metavar="IDEMPOTENCY_KEY",
                   help="reuse this key on a retry to get the same run back (default: a new random key)")
    s.set_defaults(func=cmd_call)

    s = sub.add_parser("skills", help="search and read the skills you may use (the skills hub)")
    skills = s.add_subparsers(dest="skills_command", metavar="SKILLS_COMMAND")
    host_help = "also show skills that need the T3 host (runs: host)"

    k = skills.add_parser("search", help="search skills by words, or an RE2 pattern with --mode regex")
    k.add_argument("query", metavar="QUERY")
    k.add_argument("--mode", choices=("keyword", "regex"), help="keyword (default) or regex")
    k.add_argument("--source", metavar="SLUG", help="only this skill source")
    k.add_argument("--limit", type=int, metavar="N", help="at most N results (default 10, at most 50)")
    k.add_argument("--include-host", action="store_true", help=host_help)
    k.set_defaults(func=cmd_skills_search)

    k = skills.add_parser("get", help="print one skill: its SKILL.md and its file list")
    k.add_argument("skill", metavar="SKILL", help="skill://<source>/<path>/SKILL.md, <source>/<path>, or a unique name")
    k.add_argument("--no-files", action="store_true", help="leave out the file list")
    k.set_defaults(func=cmd_skills_get)

    k = skills.add_parser("read", help="print one file of a skill")
    k.add_argument("uri", metavar="URI")
    k.add_argument("--offset", type=int, metavar="N", help="first line, 0-based")
    k.add_argument("--limit", type=int, metavar="N", help="at most N lines")
    k.add_argument("--raw", action="store_true", help="print the file's text instead of the JSON answer")
    k.set_defaults(func=cmd_skills_read)

    k = skills.add_parser("grep", help="search the contents of skill files with an RE2 pattern")
    k.add_argument("pattern", metavar="PATTERN")
    k.add_argument("--source", metavar="SLUG", help="only this skill source")
    k.add_argument("--path", metavar="GLOB", help="only files whose path in the skill matches, e.g. '**/*.md'")
    k.add_argument("--ignore-case", action="store_true", help="match case-insensitively")
    k.add_argument("--limit", type=int, metavar="N", help="at most N hits (default 50, at most 200)")
    k.add_argument("--include-host", action="store_true", help=host_help)
    k.set_defaults(func=cmd_skills_grep)

    k = skills.add_parser("sources", help="list the skill sources you see")
    k.set_defaults(func=cmd_skills_sources)

    k = skills.add_parser("list", help="list the skills you see, a page at a time")
    k.add_argument("--cursor", metavar="CURSOR", help="the next_cursor of the page before")
    k.add_argument("--limit", type=int, metavar="N", help="skills per page (default 100, at most 500)")
    k.add_argument("--source", metavar="SLUG", help="only this skill source")
    k.add_argument("--include-host", action="store_true", help=host_help)
    k.set_defaults(func=cmd_skills_list)

    k = skills.add_parser("pull", help="download skills into a local folder, such as Claude Code's ~/.claude/skills")
    k.add_argument("skills", metavar="SKILL", nargs="+",
                   help="skill://<source>/<path>/SKILL.md, <source>/<path>, or a unique name (at most 50)")
    k.add_argument("--dir", metavar="DIR", default=DEFAULT_SKILLS_DIR,
                   help="where each skill gets its folder (default %s)" % DEFAULT_SKILLS_DIR)
    k.add_argument("--force", action="store_true", help="replace a skill folder that already exists")
    k.add_argument("--reason", metavar="TEXT", help="why you pull them, 20-2000 characters, for the audit")
    k.set_defaults(func=cmd_skills_pull)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if getattr(args, "func", None) is None:
        parser.print_help(sys.stderr)
        return EXIT_USAGE
    try:
        client = Client(base_url(), read_token())
        return args.func(client, args)
    except TyError as e:
        warn(str(e))
        return e.code
    except KeyboardInterrupt:
        warn("interrupted")
        return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
