# Copy to .env (gitignored) and edit. Loaded automatically by
# `./gateway-darwin serve` from the gateway's current working directory.
# Real exported env vars override anything set here.

# --- Voice / Maestro live-call panel -----------------------------------------
GEMINI_API_KEY=
# Optional. Falls back to maestro's default (gemini-2.5-flash-preview-native-audio-dialog).
# Equivalent to the -voice-model flag.
MAESTRO_MODEL=

# --- Mattermost MCP upstream -------------------------------------------------
# Mattermost messaging is a registered upstream (cloud-ru-tech/mcp-server-mattermost),
# NOT read from this file by the gateway. The Mattermost MCP server process reads
# MATTERMOST_URL / MATTERMOST_TOKEN (e.g. via deploy/mcp-server-mattermost.service's
# EnvironmentFile), and the token is stored in the toolyard secrets broker as the
# MATTERMOST_TOKEN secret (secret://MATTERMOST_TOKEN). See docs/mattermost.md.

# --- Anything else read via os.Getenv goes here ------------------------------
# (e.g. observability/secret bridges if you add them later)
