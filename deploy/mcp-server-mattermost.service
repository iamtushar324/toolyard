# systemd unit for the Mattermost MCP server (cloud-ru-tech/mcp-server-mattermost),
# run as a localhost HTTP service that the toolyard gateway connects to as an
# `http` upstream (http://127.0.0.1:8000/mcp).
#
# HTTP transport is required for the standard toolyard deployment: the gateway
# runs as a dedicated user with ProtectHome=true (see deploy/toolyard.service)
# and therefore cannot spawn a stdio command living under /home. Running the
# server as its own service and connecting over localhost avoids that.
#
# Install (needs root):
#   sudo cp deploy/mcp-server-mattermost.service /etc/systemd/system/
#   # create the env file (mode 600) — see EnvironmentFile below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mcp-server-mattermost
#   curl http://127.0.0.1:8000/health
#   journalctl -u mcp-server-mattermost -f

[Unit]
Description=Mattermost MCP server (toolyard upstream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as the user that owns the checkout and has `uv` installed.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/mcp-server-mattermost

# Secrets + URL. Create /etc/mcp-server-mattermost.env (mode 600, root:root) with:
#   MATTERMOST_URL=https://chat.beknown.live
#   MATTERMOST_TOKEN=...            # the Mattermost bot/personal access token
#   MATTERMOST_AUTH_MODE=static_token
#   MATTERMOST_LOG_LEVEL=WARNING
EnvironmentFile=/etc/mcp-server-mattermost.env

# Bind to loopback only — the gateway reaches it over localhost.
ExecStart=/home/ubuntu/.local/bin/uv run --frozen mcp-server-mattermost --http --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

# Modest sandboxing. Note: NOT ProtectHome — the checkout and uv live under /home.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=8192
TasksMax=256
MemoryMax=512M

KillSignal=SIGINT
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
