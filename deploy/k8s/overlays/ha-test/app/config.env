# Overrides of base/config.env for the HA test deployment (merged into the
# toolyard-config ConfigMap). scripts/k8s-test-deploy.sh replaces the
# placeholders below with its HOST, TRUSTED_PROXY and OWNER_EMAIL inputs.

# Placeholder: the script sets https://<HOST>.
TOOLYARD_PUBLIC_URL=https://toolyard-test.example.com
TOOLYARD_ENVIRONMENT=test
# Ten connections per replica: with two replicas and one surge pod during a
# rollout that is 30, well under Postgres's default max_connections (100).
TOOLYARD_DB_MAX_CONNS=10
