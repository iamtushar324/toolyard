# Non-secret settings for the toolyard-config ConfigMap. Every serve flag
# can be set as TOOLYARD_<FLAG> (upper case, "-" becomes "_"); a flag on the
# command line wins. Secrets never go here: they come from files in the
# toolyard-credentials Secret. Comment lines must start with "#"; a value
# runs to the end of its line.

# The public origin users and agents reach (passkeys are bound to its host).
TOOLYARD_PUBLIC_URL=https://toolyard.example.com
# CIDR(s) of the ingress controller pods, trusted for X-Forwarded-*, and
# nothing wider: a range that covers other pods lets them fake client
# addresses. Secure cookies, HSTS and per-IP rate limits depend on it.
# The placeholder (192.0.2.0/24, a documentation range) matches no real
# traffic.
# REPLACE with your ingress controller's subnet
TOOLYARD_TRUSTED_PROXY=192.0.2.0/24
# Keys come from the Secret: never create them in the emptyDir.
TOOLYARD_KEYS=require
# Schema changes run as a separate `toolyard db migrate` step (see README).
TOOLYARD_MIGRATE=off
TOOLYARD_DB_MAX_CONNS=10
# Endpoint removal is asynchronous: keep readiness 503 long enough for the
# Service to stop sending traffic before streams close.
TOOLYARD_DRAIN_DELAY=10s
TOOLYARD_STATELESS_MCP=true
TOOLYARD_NO_STDIO_UPSTREAMS=true
TOOLYARD_NOTES=off
TOOLYARD_SKILLS=off
# tools.search ranker: off, or openrouter-decisions (docs/self-hosting.md).
TOOLYARD_TOOL_SEARCH_RANKER=off
TOOLYARD_MEMPALACE=off
TOOLYARD_VOICE=off
TOOLYARD_UPSTREAM_IDLE_TIMEOUT=15m
TOOLYARD_ENVIRONMENT=production
# auto falls back when the node cannot confine script workers; switch to
# required once /v1/health reports landlock-abi-<n>+seccomp on your nodes.
TOOLYARD_CODEMODE_SANDBOX=auto
# TOOLYARD_OWNER_EMAIL=owner@example.com
GOMEMLIMIT=200MiB
GOGC=50
