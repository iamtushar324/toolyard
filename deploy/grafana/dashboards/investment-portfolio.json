          "editorType": "sql",
          "queryType": "table",
          "rawSql": "WITH latest_v AS ( SELECT investment_key, market_value, as_of_date,  ROW_NUMBER() OVER (PARTITION BY investment_key ORDER BY as_of_date DESC) rn  FROM mart.fact_investment_valuation) SELECT i.display_name AS name, CASE i.asset_class WHEN 'equity_india' THEN 'India Equity' WHEN 'equity_us' THEN 'US Equity' WHEN 'mutual_fund' THEN 'Mutual Fund' WHEN 'fd' THEN 'FD' WHEN 'ulip' THEN 'ULIP' WHEN 'peer_lending' THEN 'Peer Lending' ELSE i.asset_class END AS class, v.market_value AS current_value, i.holder_name, i.plan_type FROM mart.dim_investment i JOIN latest_v v ON v.investment_key = i.investment_key AND v.rn = 1 WHERE i.is_current = TRUE AND v.market_value > 0 ORDER BY current_value DESC",
