    {
      "id": 11,
      "title": "FD Maturity Timeline",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "toolyard-lake"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "toolyard-lake"
          },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "WITH latest_v AS ( SELECT investment_key, market_value, as_of_date,  ROW_NUMBER() OVER (PARTITION BY investment_key ORDER BY as_of_date DESC) rn  FROM mart.fact_investment_valuation) SELECT i.display_name, v.market_value AS principal, i.interest_rate, a.institution, i.holder_name, i.maturity_date, dateDiff('day', today(), i.maturity_date) AS days_left FROM mart.dim_investment i LEFT JOIN mart.dim_account a   ON i.account_key = a.account_key AND a.is_current = TRUE LEFT JOIN latest_v v   ON v.investment_key = i.investment_key AND v.rn = 1 WHERE i.asset_class = 'fd' AND i.is_current = TRUE ORDER BY i.maturity_date",
          "format": 1,
          "meta": {
            "timezone": ""
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Principal"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Days Left"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
