          "editorType": "sql",
          "queryType": "table",
          "rawSql": "WITH latest_v AS ( SELECT investment_key, market_value, as_of_date,  ROW_NUMBER() OVER (PARTITION BY investment_key ORDER BY as_of_date DESC) rn  FROM mart.fact_investment_valuation) SELECT COALESCE(SUM(v.market_value),0) AS total FROM mart.dim_investment i JOIN latest_v v ON v.investment_key = i.investment_key AND v.rn = 1 WHERE i.is_current = TRUE",
