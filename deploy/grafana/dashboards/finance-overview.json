            "type": "grafana-clickhouse-datasource",
            "uid": "toolyard-lake"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(as_of_date) AS time, net_worth FROM mart.fact_net_worth_snapshot ORDER BY time",
