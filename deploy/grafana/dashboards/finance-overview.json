    {
      "id": 4,
      "title": "Monthly Burn",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "toolyard-lake"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "steps": [
              {
                "value": null,
                "color": "orange"
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "toolyard-lake"
          },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT ROUND(SUM(CASE frequency WHEN 'monthly' THEN amount WHEN 'yearly' THEN amount/12.0 WHEN 'half_yearly' THEN amount/6.0 WHEN 'quarterly' THEN amount/3.0 ELSE amount END), 2) AS monthly_burn FROM mart.fact_recurring_schedule WHERE is_active = TRUE",
          "format": 1,
          "meta": {
            "timezone": ""
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "/.*/"
        }
      }
    },
