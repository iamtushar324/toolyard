      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "toolyard-lake"
          },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "WITH latest_v AS ( SELECT investment_key, market_value, as_of_date,  ROW_NUMBER() OVER (PARTITION BY investment_key ORDER BY as_of_date DESC) rn  FROM mart.fact_investment_valuation) SELECT i.asset_class AS category, COALESCE(SUM(v.market_value),0) AS value FROM mart.dim_investment i JOIN latest_v v ON v.investment_key = i.investment_key AND v.rn = 1 WHERE i.is_current = TRUE GROUP BY 1 ORDER BY 2 DESC",
          "format": 1,
          "meta": {
            "timezone": ""
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Value"
          ]
        }
